# Server only. Never prefix secrets with NEXT_PUBLIC_, VITE_, or PUBLIC_.
DATABASE_URL=postgresql://pcw_runtime:replace-in-secret-manager@pooler.example:6543/postgres
# Optional custom certificate for managed PostgreSQL; TLS verification stays enabled.
DATABASE_CA=
PCW_ORIGIN=http://localhost:3000
PCW_OWNER_GITHUB_ID=326690450
PCW_ENCRYPTION_KEY=
# Rotation: JSON map, newest key first, keep old keys until stored secrets are migrated.
PCW_ENCRYPTION_KEYS=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
CRON_SECRET=
# Optional administrator-approved exact HTTPS hosts for compatible model APIs.
PCW_PROVIDER_HOSTS=
